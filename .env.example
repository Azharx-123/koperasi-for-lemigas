# PRODUCTION CHECKLIST — this file is a local-dev template on purpose, so
# it stays as-is here. But before deploying, your real .env on the server
# must change these two:
#   APP_ENV=production
#   APP_DEBUG=false   (true here shows every visitor a full stack trace on
#                       any error — including server file paths — instead
#                       of a generic error page)
APP_NAME="KEP"
APP_ENV=local
APP_KEY=base64:Fllllllllllllllllllllll
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kep_portfolio
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUCTION: set to true once the site is served over HTTPS, so the
# session cookie is never sent over a plain-HTTP connection.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PRODUCTION: "log" just writes emails to storage/logs instead of sending
# them — fine for local dev, but registration (email verification) and
# "forgot password" both depend on a real mail transport. Switch this to
# "smtp" and fill in real MAIL_HOST/PORT/USERNAME/PASSWORD before deploying,
# or those two flows will silently never deliver anything to users.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
